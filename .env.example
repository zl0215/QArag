# ============================================================
# 复制为 .env 后按需修改。所有键都可被同名环境变量覆盖。
# ============================================================

APP_ENV=dev
LOG_LEVEL=INFO
API_PORT=8000

# ------------------------------------------------------------
# PostgreSQL —— 唯一事实源，同时承载 LangGraph checkpointer
# ------------------------------------------------------------
# repository_backend: postgres | memory
#   memory 会把正文/分块/任务表/checkpoint 全放进进程内 —— 重启即丢，
#   且没有任务队列（worker 必须与 API 同进程）。只够先看一眼效果。
REPOSITORY_BACKEND=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag_dev_pw
POSTGRES_DB=rag
# 直接覆盖完整 URL（优先级高于上面的分项，容器内用服务名）
# DATABASE_URL=postgresql+asyncpg://rag:rag_dev_pw@postgres:5432/rag

# ------------------------------------------------------------
# Milvus
# ------------------------------------------------------------
# ★ 同一个 VECTOR_BACKEND=milvus 有两种形态，靠 MILVUS_URI 的**格式**区分：
#
#   http://host:19530   → 连 standalone / 集群（走网络，要 Docker）
#   ./data/milvus.db    → Milvus Lite（本地文件，零网络依赖）
#
#   Lite 不需要 Docker、不需要第二个进程，AutoDL 标准实例就用它。
#   它把 uri 当**目录**（data_dir）用，不是单文件。
#   启用：uv sync --extra lite
#
#   ⚠ Lite 的两条真实限制（实测确认，不是传言）：
#     1. 一个 data_dir 同时只能被**一个进程**打开 —— 不能多开 uvicorn，
#        也不能和 worker 同时跑。
#     2. BM25 的 IDF 统计是**分段局部的**（每 segment 各算），不是全库统计，
#        语料大了稀疏召回会比 standalone 差一截。
#   （BM25 Function / 稀疏检索本身是**支持**的，已实测通过。）
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=rag_chunks
# 建集合时使用；换分词器/维度只能新建集合（Milvus 不支持改 schema）
#   standalone → chinese（jieba 的增强版，含词典与停用词）
#   Lite       → ★ 只认 jieba / standard，填 chinese 会在建集合时直接报错
MILVUS_ANALYZER=chinese

# ------------------------------------------------------------
# 向量后端：milvus | memory
#   milvus —— ★ 推荐。standalone（网络）或 Lite（本地文件）都走这个，
#             由上面 MILVUS_URI 的格式决定，不是两个后端
#   memory —— 纯内存，进程退出即丢，只用于单测和一次性冒烟
# ------------------------------------------------------------
VECTOR_BACKEND=memory

# ------------------------------------------------------------
# Embedding
# provider: local | api | hash
#   local —— sentence-transformers 在**本进程内**加载 BGE
#   api   —— 调用**独立的推理服务**（TEI / vLLM / Xinference / 硅基流动）
#   hash  —— 确定性假向量，仅单测用，不表达语义
#
# ★ local 和 api 的区别不是"本地 vs 云端"，而是"模型跑在哪"：
#   local = 模型在 api 容器里，api 容器要装 torch（镜像 2.2GB）
#   api   = 模型在另一个容器里，api 容器不装 torch（镜像 450MB）
#   两者都可以完全离线、都不出你的机器。推荐 api（见 compose 的 models profile）。
# ------------------------------------------------------------
EMBED_PROVIDER=local
# 本地模型目录。Windows 开发直接指本机；服务器上拷到 ./models 由 compose 挂载
EMBED_MODEL_PATH=D:/PythonDemo_learn/shucang/embedding/bge-m3
EMBED_MODEL_ID=BAAI/bge-m3
EMBED_DIM=1024
# 留空则从模型的 max_seq_length 自动推断，避免配置与实际权重不一致
EMBED_MAX_TOKENS=
# BGE-M3 不需要中文专用 query 前缀；留空也避免污染翻译后的英文查询
EMBED_QUERY_INSTRUCTION=
EMBED_BATCH_SIZE=16
# cpu | cuda | cuda:0 —— provider=local 且机器有 GPU 时改成 cuda，吞吐差一个数量级
EMBED_DEVICE=cpu
# 模型冷启动几十秒。true = 启动时阻塞加载完（/healthz 就绪即代表可用）；
# false = 先就绪、后台加载（API 起得快，但首个请求会等）
EMBED_WARMUP_ON_STARTUP=true

# provider=api 时使用
#   api_style=openai → POST {base}/embeddings，body {"model","input"}（vLLM/Xinference/硅基流动）
#   api_style=tei    → POST {base}/embed，body {"inputs":[...]}（HuggingFace TEI）
# compose 的 embed 服务默认就是 TEI，容器内地址 http://embed:80
#
# ★ scripts/serve_inference.py（跑在 AutoDL 上）也是 TEI 这一套线格式，
#   本机通过 SSH 隧道指过去：先 `ssh -N -L 8081:127.0.0.1:8080 autodl`，
#   再把下面的 BASE 改成 http://127.0.0.1:8081、STYLE 改成 tei。
#   这样本机进程不加载模型，上传时的嵌入算力全部落在 GPU 上。
#   详见 docs/DEPLOY.md 第四节末尾。
EMBED_API_BASE=https://api.siliconflow.cn/v1
EMBED_API_KEY=
EMBED_API_MODEL=BAAI/bge-m3
EMBED_API_STYLE=openai
EMBED_TIMEOUT_SECONDS=60

# ------------------------------------------------------------
# Reranker
# provider: local | api | none
#   local —— 本进程内 CrossEncoder（需要 torch，镜像变大）
#   api   —— 独立推理服务（推荐；TEI 同一个容器既能做 embedding 也能做 rerank）
#   none  —— 不重排，直接用 RRF 顺序（消融实验的基线）
#
# ★ 不要长期用 none。RAG 的相关性判定最终依赖 rerank 分：
#   双塔余弦区分不了"像"和"真相关" —— 实测领域内 0.51~0.60、领域外 0.29~0.49，
#   区间重叠，设阈值必然误判。cross-encoder 直接把区分度拉到
#   0.98（相关）对 0.0001（无关），拒答与排序都要靠它。
# ------------------------------------------------------------
RERANK_PROVIDER=none
RERANK_MODEL_PATH=
RERANK_API_BASE=https://api.siliconflow.cn/v1
RERANK_API_KEY=
RERANK_API_MODEL=BAAI/bge-reranker-v2-m3
# cohere → 解析 {"results":[{"index","relevance_score"}]}（Cohere/Jina/硅基流动）
# tei    → 解析 [{"index","score"}]（HuggingFace TEI）
RERANK_API_STYLE=cohere
RERANK_TIMEOUT_SECONDS=60

# ------------------------------------------------------------
# LLM（OpenAI 兼容）
# provider: openai | none   —— none 时 /chat 会返回 503，但摄取与检索仍可用
# ------------------------------------------------------------
LLM_PROVIDER=none
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# 路由/评分/校验用的便宜模型（可与主模型相同）
LLM_MODEL_CHEAP=deepseek-chat
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=120

# ------------------------------------------------------------
# 分块
# ------------------------------------------------------------
CHUNK_TARGET_TOKENS=256
CHUNK_MAX_TOKENS=384
CHUNK_OVERLAP_TOKENS=48
# 父块（喂给 LLM 的生成单元）
PARENT_TARGET_TOKENS=1024
# ★ 变更分块参数/逻辑时必须 bump，否则增量索引会复用旧块
CHUNKER_VERSION=v3-layout-metadata

# ------------------------------------------------------------
# 检索
# ------------------------------------------------------------
RETRIEVE_DENSE_TOP_K=50
RETRIEVE_SPARSE_TOP_K=50
RETRIEVE_FUSED_TOP_K=60
RETRIEVE_FINAL_TOP_K=5
RRF_K=60
# 低于该分数的 chunk 直接丢弃（防幻觉第一层）
RETRIEVE_SCORE_THRESHOLD=0.0
# 上下文 token 预算
CONTEXT_MAX_TOKENS=4000

# ------------------------------------------------------------
# Agent
# ------------------------------------------------------------
AGENT_MAX_RETRIES=2
AGENT_RECURSION_LIMIT=50
# 超过该轮数就压缩历史为摘要
AGENT_SUMMARY_AFTER_TURNS=20
AGENT_MAX_ITERATIONS=8
AGENT_TOOL_TIMEOUT_SECONDS=120

# ------------------------------------------------------------
# Neo4j（图谱增强，一期默认关闭）
# ------------------------------------------------------------
ENABLE_GRAPH=false
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=rag_dev_pw
GRAPH_MAX_TRIPLETS_PER_CHUNK=30
GRAPH_EXPAND_LIMIT=20

# ------------------------------------------------------------
# 上传
# ------------------------------------------------------------
UPLOAD_MAX_MB=50
UPLOAD_DIR=./data/uploads

# ------------------------------------------------------------
# Worker（python -m rag.worker）
# ------------------------------------------------------------
# 队列空的时候多久轮询一次。1~5 秒都合理：太长会让新任务白等，
# 太短只是在空刷数据库。
WORKER_POLL_INTERVAL_SECONDS=2
# 一轮最多连续领几个任务。领完一轮才回去看停止位 ——
# 设太大会让 Ctrl-C 之后要等很久才退。
WORKER_BATCH_SIZE=4
#
# ★ 关于领取任务的租约（DEFAULT_LOCK_SECONDS，代码里写死 900 秒，不在这配）：
#   它的作用是**故障恢复**，不是超时取消。worker 被 kill -9 时来不及把任务
#   标失败，那条任务会永远停在 running；过了租约时间，别的 worker 才能重领。
#   所以它必须**大于最慢的一次摄取**（大 PDF 解析 + 嵌入可能要几分钟），
#   定太短会让正常跑着的任务被第二个 worker 抢走 —— 那就变成重复摄取了。
#
# ★ worker 会拒绝 REPOSITORY_BACKEND=memory（独立进程看不见内存队列）
#   和 Milvus Lite（一个 data_dir 只能一个进程打开）。详见 docs/DEPLOY.md 第六节。

# ------------------------------------------------------------
# 部署（docker compose 用，应用本身不读这些）
# ------------------------------------------------------------
# 模型权重在宿主机上的目录，挂载到容器的 /models（只读）
MODEL_DIR=./models
# 是否在应用镜像里安装 torch + sentence-transformers
#   true  = 进程内加载模型（镜像 ~2.2GB）
#   false = 配合 --profile models 走独立推理服务（镜像 ~450MB）★ 推荐
WITH_LOCAL=true
# 构建用的基础镜像与应用内端口
BASE_IMAGE=python:3.12-slim
API_PORT=8000
# 进程内加载模型时 API 冷启动要几十秒，健康检查的宽限期
API_START_PERIOD=120s
# Milvus 容器内存上限。8GB 宿主机上建议 3G
MILVUS_MEM_LIMIT=5G
MILVUS_VERSION=v2.6.11
# TEI 推理服务镜像。★ tag 命名按硬件平台区分，用前先去 TEI releases 页确认
TEI_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-1.8
TEI_IMAGE_GPU=ghcr.io/huggingface/text-embeddings-inference:1.8
# GPU 构建：BASE_IMAGE=pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime
#          TORCH_INDEX_URL=https://download.pytorch.org/whl/cu124
TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
